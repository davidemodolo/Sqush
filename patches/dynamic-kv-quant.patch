+// the K/V row widths of a cache layer and the buffer type it is placed in
+struct kv_layer_dims {
+    ggml_backend_buffer_type_t buft;
+    uint32_t n_embd_k;
+    uint32_t n_embd_v;
+    bool     has_v;
+};
