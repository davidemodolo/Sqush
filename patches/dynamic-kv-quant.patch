+// one region per K/V tensor, sized for the last stage and shared by the tensors of all stages
+ggml_backend_buffer_t llama_kv_cache::alloc_stage_buffer(
+        ggml_backend_buffer_type_t buft, const std::vector<ggml_backend_buffer_type_t> & layer_bufts) {
+        const size_t alignment = ggml_backend_buft_get_alignment(buft);
+
+        size_t budget = 0;
+
+        for (size_t l = 0; l < layers.size(); ++l) {
+            if (layer_bufts[l] != buft) {
+                continue;
+            }
+
+            const auto & kl = kv_stages_layers.back()[l];
+
+            budget += ggml_backend_buft_get_alloc_size(buft, kl.k);
+            if (kl.v) {
+                budget += ggml_backend_buft_get_alloc_size(buft, kl.v);
+            }
+        }
+
+        // reserve some padding for the region alignment
+        ggml_backend_buffer_t buf = ggml_backend_buft_alloc_buffer(buft, budget + 2*alignment*(layers.size() + 1));
+        if (!buf) {
+            throw std::runtime_error("failed to allocate buffer for kv cache");
+        }
+
+        size_t offset = 0;
+
+        const auto alloc_region = [&](size_t l, bool is_v) {
+            const auto & kl = kv_stages_layers.back()[l];
+
+            const size_t size_region = ggml_backend_buft_get_alloc_size(buft, is_v ? kl.v : kl.k);
+
+            offset = GGML_PAD(offset, alignment);
+
+            char * addr = (char *) ggml_backend_buffer_get_base(buf) + offset;
+
+            for (size_t s = 0; s < kv_stages_layers.size(); ++s) {
+                ggml_tensor * t = is_v ? kv_stages_layers[s][l].v : kv_stages_layers[s][l].k;
+
+                if (ggml_backend_buft_get_alloc_size(buft, t) > size_region) {
+                    throw std::runtime_error("dynamic KV quantization: stage does not fit the memory budget");
+                }
+
+                if (ggml_backend_tensor_alloc(buf, t, addr) != GGML_STATUS_SUCCESS) {
+                    throw std::runtime_error("failed to allocate kv cache tensor");
+                }
+
+                const auto & views = is_v ? kv_stages_layers[s][l].v_stream : kv_stages_layers[s][l].k_stream;
+
+                for (ggml_tensor * view : views) {
+                    if (!view) {
+                        continue;
+                    }
+
+                    if (ggml_backend_view_init(view) != GGML_STATUS_SUCCESS) {
+                        throw std::runtime_error("failed to initialize kv cache view");
+                    }
+                }
+            }
+
+            offset += size_region;
+        };
+
+        for (size_t l = 0; l < layers.size(); ++l) {
+            if (layer_bufts[l] != buft) {
+                continue;
+            }
+
+            alloc_region(l, false);
+
+            if (kv_stages_layers.back()[l].v) {
+                alloc_region(l, true);
+            }
+        }
+
+    return buf;
+}
+
+// flag set on the stream count of a saved state that carries the dynamic KV quantization stage
+static constexpr uint32_t KV_STATE_STAGE_TAG = 0x40000000u;
+
+// convert the first n_rows rows of a K/V cache stream in place (src and dst share the same memory)
+// shrinking rows are processed from the start and growing rows from the end, so no unread row is overwritten
+static void kv_convert_rows(ggml_tensor * src, ggml_tensor * dst, int64_t n_rows) {
+    GGML_ASSERT(src->ne[0] == dst->ne[0]);
+    GGML_ASSERT(src->data == dst->data);
+
+    if (n_rows == 0) {
+        return;
+    }
+
+    const auto * tr_old = ggml_get_type_traits(src->type);
+    const auto * tr_new = ggml_get_type_traits(dst->type);
+
+    const int64_t ne0     = src->ne[0];
+    const size_t  row_old = ggml_row_size(src->type, ne0);
+    const size_t  row_new = ggml_row_size(dst->type, ne0);
+
+    GGML_ASSERT(n_rows <= src->ne[1] && n_rows <= dst->ne[1]);
+
+    const int64_t n_chunk = std::max<int64_t>(1, std::min<int64_t>(n_rows, (int64_t) ((64u << 20)/std::max(row_old, row_new))));
+
+    std::vector<uint8_t> buf_src(n_chunk*row_old);
+    std::vector<uint8_t> buf_dst(n_chunk*row_new);
+
+    const int64_t n_threads = std::max<int64_t>(1, std::min<int64_t>(16, std::thread::hardware_concurrency()));
+
+    // the rows are independent, so each chunk is converted by several threads
+    const auto convert_range = [&](int64_t i0, int64_t i1) {
+        std::vector<float> f32(ne0);
+
+        for (int64_t i = i0; i < i1; ++i) {
+            tr_old->to_float(buf_src.data() + i*row_old, f32.data(), ne0);
+            tr_new->from_float_ref(f32.data(), buf_dst.data() + i*row_new, ne0);
+        }
+    };
+
+    const auto convert = [&](int64_t a, int64_t n) {
+        ggml_backend_tensor_get(src, buf_src.data(), a*row_old, n*row_old);
+
+        const int64_t n_per_thread = (n + n_threads - 1)/n_threads;
+
+        std::vector<std::thread> workers;
+        for (int64_t i0 = n_per_thread; i0 < n; i0 += n_per_thread) {
+            workers.emplace_back(convert_range, i0, std::min(n, i0 + n_per_thread));
+        }
+
+        convert_range(0, std::min(n, n_per_thread));
+
+        for (auto & w : workers) {
+            w.join();
+        }
+
+        ggml_backend_tensor_set(dst, buf_dst.data(), a*row_new, n*row_new);
+    };
+
+    if (row_new <= row_old) {
+        for (int64_t a = 0; a < n_rows; a += n_chunk) {
+            convert(a, std::min<int64_t>(n_rows - a, n_chunk));
+        }
+    } else {
+        for (int64_t a = n_rows; a > 0; ) {
+            const int64_t n = std::min<int64_t>(a, n_chunk);
+            a -= n;
+
+            convert(a, n);
+        }
+    }
+}
+
+// zero the rows [n0, n1) of a K/V cache stream, so that the stale bytes of another stage layout
+// are not interpreted as values of this type (some bit patterns can decode to NaN)
+static void kv_zero_rows(ggml_tensor * t, uint32_t n0, uint32_t n1) {
+    if (n1 <= n0) {
+        return;
+    }
+
+    const size_t row = ggml_row_size(t->type, t->ne[0]);
+
+    ggml_backend_tensor_memset(t, 0, n0*row, (n1 - n0)*row);
+}
+
+uint32_t llama_kv_cache::stage_used() const {
+    uint32_t used = 0;
+
+    for (uint32_t s = 0; s < n_stream; ++s) {
+        used = std::max(used, v_cells[s].used_max_p1());
+    }
+
+    return used;
+}
+
+bool llama_kv_cache::set_stage(uint32_t stage) {
+    if (kv_stages_layers.empty() || stage >= kv_stages_layers.size()) {
+        return false;
+    }
+
+    if (stage == kv_stage_cur) {
+        return true;
+    }
+
+    const uint32_t used    = stage_used();
+    const uint32_t cap_new = kv_stage_capacity[stage];
+
+    if (used > cap_new) {
+        return false;
+    }
+
+    const int64_t t_start_us = ggml_time_us();
+
+    const ggml_type type_old = kv_stages.types[kv_stage_cur];
+    const ggml_type type_new = kv_stages.types[stage];
+
+    const auto & layers_new = kv_stages_layers[stage];
+
+    GGML_ASSERT(layers_new.size() == layers.size());
+
+    for (size_t l = 0; l < layers.size(); ++l) {
+        for (uint32_t s = 0; s < n_stream; ++s) {
+            kv_convert_rows(layers[l].k_stream[s], layers_new[l].k_stream[s], used);
+            kv_zero_rows(layers_new[l].k_stream[s], used, cap_new);
+
+            if (layers[l].v) {
+                kv_convert_rows(layers[l].v_stream[s], layers_new[l].v_stream[s], used);
+                kv_zero_rows(layers_new[l].v_stream[s], used, cap_new);
+            }
+        }
+    }
+
+    kv_stage_cur = stage;
+    layers = layers_new;
+
+    for (uint32_t s = 0; s < n_stream; ++s) {
+        v_cells[s].resize_preserve(cap_new);
+        v_heads[s] = std::min(v_heads[s], used);
+    }
+
+    kv_requantized = true;
+
+    LLAMA_LOG_INFO("%s: converted KV cache %s -> %s, %u cells in use, capacity %u cells (%.2f ms)\n", __func__,
+            ggml_type_name(type_old), ggml_type_name(type_new), used, get_size(), (ggml_time_us() - t_start_us)/1000.0);
+
+    return true;
+}
+
+bool llama_kv_cache::try_requantize() {
+    if (kv_stage_cur + 1 >= kv_stages_layers.size() || layers.empty()) {
+        return false;
+    }
+
+    return set_stage(kv_stage_cur + 1);
+}
+
+bool llama_kv_cache::try_requantize_if_needed() {
+    if (kv_stage_cur + 1 >= kv_stages_layers.size() || kv_stages.margin == 0) {
+        return false;
+    }
+
+    if (stage_used() + kv_stages.margin < get_size()) {
+        return false;
+    }
+
+    return try_requantize();
+}
+
+bool llama_kv_cache::try_restore_stage() {
+    if (kv_stage_cur == 0 || kv_stages_layers.empty()) {
+        return false;
+    }
+
+    // go back to the highest-precision stage that is at most half full after the switch
+    // the cells in use keep their lower precision, so only the free half gains from it
+    const uint32_t used = stage_used();
+
+    for (uint32_t s = 0; s < kv_stage_cur; ++s) {
+        if ((uint64_t) used + 2ull*kv_stages.margin <= kv_stage_capacity[s] && 2ull*used <= kv_stage_capacity[s]) {
+            return set_stage(s);
+        }
+    }
+
+    return false;
+}
+
+bool llama_kv_cache::check_and_clear_requantized() {
+    const bool res = kv_requantized;
+
+    kv_requantized = false;
+
+    return res;
+}
