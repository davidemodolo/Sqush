+// drop the first stage that does not shrink the rows of every layer, and the stages after it
+static void kv_stages_drop_useless(std::vector<ggml_type> & types, const std::vector<kv_layer_dims> & dims) {
+    for (size_t s = 1; s < types.size(); ++s) {
+        for (const auto & d : dims) {
+            const bool smaller_k = ggml_row_size(types[s], d.n_embd_k) < ggml_row_size(types[s - 1], d.n_embd_k);
+            const bool smaller_v = !d.has_v || ggml_row_size(types[s], d.n_embd_v) < ggml_row_size(types[s - 1], d.n_embd_v);
+
+            if (!smaller_k || !smaller_v) {
+                LLAMA_LOG_WARN("%s: stage %s does not reduce the cache size - dropping it and the following stages\n",
+                        __func__, ggml_type_name(types[s]));
+                types.resize(s);
+                return;
+            }
+        }
+    }
+}
+
+// cells per stage when each buffer type holds the last stage at kv_size cells
+static std::vector<uint32_t> kv_stage_capacities(
+        const std::vector<ggml_type> & types, const std::vector<kv_layer_dims> & dims,
+        uint32_t n_stream, uint32_t kv_size, uint32_t n_pad) {
+    std::map<ggml_backend_buffer_type_t, std::vector<size_t>, kv_buft_less> bytes_per_cell;
+
+    for (const auto & d : dims) {
+        auto & bpc = bytes_per_cell[d.buft];
+        bpc.resize(types.size(), 0);
+
+        for (size_t s = 0; s < types.size(); ++s) {
+            bpc[s] += (ggml_row_size(types[s], d.n_embd_k) + (d.has_v ? ggml_row_size(types[s], d.n_embd_v) : 0))*n_stream;
+        }
+    }
+
+    std::vector<uint32_t> capacity(types.size(), kv_size);
+
+    for (const auto & [buft, bpc] : bytes_per_cell) {
+        const size_t budget = bpc.back()*kv_size;
+
+        for (size_t s = 0; s < bpc.size(); ++s) {
+            if (bpc[s] > 0) {
+                capacity[s] = std::min(capacity[s], (uint32_t) std::min<size_t>(kv_size, budget / bpc[s]));
+            }
+        }
+    }
+
+    for (auto & cap : capacity) {
+        cap -= cap % n_pad;
+    }
+
+    return capacity;
